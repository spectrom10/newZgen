---
import '../styles/global.css';
import '../styles/designs.css';
import { categories } from '../lib/categories';
import { siteSettings } from '../lib/site';
const { title='newZgen — The news behind the news', description='The news behind the news. Understand how events connect and what they mean for you.', image, canonicalPath=Astro.url.pathname } = Astro.props;
const canonical = new URL(canonicalPath, Astro.site ?? Astro.url.origin).toString();
const socialImage = image ? new URL(image, Astro.site ?? Astro.url.origin).toString() : undefined;
const isPaperHome = Astro.url.pathname === '/preview/paper' || (Astro.url.pathname === '/' && siteSettings.homepageDesign === 'paper');
const paperInterior = siteSettings.homepageDesign === 'paper' && !['/', '/preview/paper', '/preview/city'].includes(Astro.url.pathname);
const paperShell = isPaperHome || paperInterior;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#f5f0e6" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600;6..72,700&display=swap" rel="stylesheet" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="newZgen" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {socialImage && <meta property="og:image" content={socialImage} />}
  <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
  <title>{title}</title>
</head>
<body class:list={[{'paper-shell': paperShell}]}>
  <a href="#main" style="position:absolute;top:-80px;left:10px;background:white;padding:.5rem;z-index:9" onfocus="this.style.top='10px'" onblur="this.style.top='-80px'">Skip to content</a>
  {!paperShell && <header class="site-header">
    <div class="wrap masthead">
      <a class="brand" href="/" aria-label="newZgen home">{siteSettings.brand.logoImage ? <img class="brand-image" src={siteSettings.brand.logoImage} alt="newZgen"/> : <>new<span class="z">Z</span>gen.</>}</a>
      <span class="tagline">{siteSettings.brand.tagline}</span>
    </div>
    <nav class="topnav" aria-label="Main navigation"><div class="wrap">
      <a href="/" aria-current={Astro.url.pathname==='/'?'page':undefined}>Home</a><a href="/preview/city" aria-current={Astro.url.pathname==='/preview/city'?'page':undefined}>City design</a><a href="/preview/paper" aria-current={Astro.url.pathname==='/preview/paper'?'page':undefined}>Paper design</a>
      {categories.map(c=><a href={`/topics/${c.slug}`} aria-current={Astro.url.pathname===`/topics/${c.slug}`?'page':undefined}>{c.name}</a>)}
      <a href="/about" aria-current={Astro.url.pathname==='/about'?'page':undefined}>About</a>
    </div></nav>
  </header>}
  {paperInterior && <header class="paper-experience"><div class="paper-internal-header wrap"><div class="paper-internal-top"><span>INDEPENDENT NEWS FOR THE CURIOUS</span><a href="/preview/city">SEE THE CITY CONCEPT ↗</a></div><div class="paper-internal-brand"><a href="/">{siteSettings.brand.logoImage ? <img src={siteSettings.brand.logoImage} alt="newZgen"/> : <>new<span>Z</span>gen.</>}</a><span>THE NEWS BEHIND THE NEWS.</span></div><nav class="paper-internal-nav" aria-label="Newspaper navigation"><a href="/">Front page</a>{categories.map(c=><a href={`/topics/${c.slug}`}>{c.name}</a>)}<a href="/about">About</a></nav></div></header>}
  <main id="main"><slot /></main>
  {paperInterior && <footer class="paper-experience"><div class="paper-internal-footer wrap"><strong>new<span>Z</span>gen.</strong><span>The news behind the news. © {new Date().getFullYear()}</span><a href="/">Back to front page ↗</a></div></footer>}
  {!paperShell && <footer class="footer"><div class="wrap"><span>© {new Date().getFullYear()} newZgen · Independent editorial media</span><span>The news behind the news.</span></div></footer>}
</body>
</html>
